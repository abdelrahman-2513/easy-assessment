# Application
NODE_ENV=development
PORT=3001

# Database (MongoDB)
# Local: mongodb://localhost:27017/easy_assessment
# Docker: mongodb://mongodb:27017/easy_assessment
DATABASE_URL=mongodb://localhost:27017/easy_assessment

# Auth
JWT_SECRET=change-me-in-production

# Rate limiting (@nestjs/throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=10
